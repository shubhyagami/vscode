# ==============================================================================
# Environment Configuration for Code-Server + Java on Render
# ==============================================================================

# Render sets this automatically (defaults to 8080)
PORT=8080

# Your Public Database Link / Endpoint
# When files are edited or saved in VS Code, they are pushed to this URL.
DATABASE_PUBLIC_URL=

# Optional: Bearer token or API key for your database
DATABASE_API_KEY=

# Optional: Password to protect your VS Code on the public internet
# If left empty, direct access without password will be enabled.
PASSWORD=
